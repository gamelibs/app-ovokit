{
  "schemaVersion": "ovoui-skin@1",
  "name": "result_skin",
  "canvas": {
    "width": 750,
    "height": 1334
  },
  "root": {
    "id": "root",
    "type": "container",
    "x": 0,
    "y": 0,
    "w": 750,
    "h": 1334,
    "children": [
      {
        "id": "result_image",
        "type": "image",
        "x": 275,
        "y": 200,
        "w": 200,
        "h": 200,
        "style": {
          "fill": "#334155"
        }
      },
      {
        "id": "result_score",
        "type": "text",
        "x": 175,
        "y": 432,
        "w": 400,
        "h": 48,
        "text": "0%",
        "style": {
          "fontSize": 28,
          "fill": "#ffffff",
          "align": "center"
        }
      },
      {
        "id": "result_message",
        "type": "text",
        "x": 175,
        "y": 512,
        "w": 400,
        "h": 48
      },
      {
        "id": "retry_btn",
        "type": "button",
        "x": 255,
        "y": 592,
        "w": 240,
        "h": 72,
        "text": "Try Again",
        "style": {
          "fontSize": 24,
          "color": "#ffffff",
          "backgroundColor": "#0ea5e9",
          "borderRadius": 8,
          "align": "center"
        },
        "event": "game.retry"
      },
      {
        "id": "next_btn",
        "type": "button",
        "x": 255,
        "y": 696,
        "w": 240,
        "h": 72,
        "text": "Next",
        "style": {
          "fontSize": 24,
          "color": "#ffffff",
          "backgroundColor": "#0ea5e9",
          "borderRadius": 8,
          "align": "center"
        },
        "event": "level.next"
      },
      {
        "id": "level_select_btn_result",
        "type": "button",
        "x": 255,
        "y": 800,
        "w": 240,
        "h": 72,
        "text": "Level Select",
        "style": {
          "fontSize": 24,
          "color": "#ffffff",
          "backgroundColor": "#0ea5e9",
          "borderRadius": 8,
          "align": "center"
        },
        "event": "level.select.open"
      },
      {
        "id": "menu_btn_result",
        "type": "button",
        "x": 255,
        "y": 904,
        "w": 240,
        "h": 72,
        "text": "Main Menu",
        "style": {
          "fontSize": 24,
          "color": "#ffffff",
          "backgroundColor": "#0ea5e9",
          "borderRadius": 8,
          "align": "center"
        },
        "event": "game.menu"
      }
    ]
  }
}