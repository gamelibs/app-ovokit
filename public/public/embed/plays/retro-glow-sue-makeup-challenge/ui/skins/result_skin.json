{
  "schemaVersion": "ovoui-skin@1",
  "name": "result_skin",
  "canvas": {
    "width": 750,
    "height": 1334
  },
  "root": {
    "id": "root",
    "type": "container",
    "x": 0,
    "y": 0,
    "w": 750,
    "h": 1334,
    "children": [
      {
        "id": "result_title",
        "type": "text",
        "x": 175,
        "y": 200,
        "w": 400,
        "h": 48,
        "text": "Cleaning Complete!",
        "style": {
          "fontSize": 28,
          "fill": "#ffffff",
          "align": "center"
        }
      },
      {
        "id": "before_after",
        "type": "container",
        "x": 225,
        "y": 280,
        "w": 300,
        "h": 300,
        "text": "Before & After",
        "style": {
          "fontSize": 28,
          "fill": "#ffffff",
          "align": "center"
        }
      },
      {
        "id": "sparkle_effect",
        "type": "image",
        "x": 275,
        "y": 612,
        "w": 200,
        "h": 200,
        "text": "Sparkles",
        "style": {
          "fill": "#334155"
        }
      },
      {
        "id": "restart_btn",
        "type": "button",
        "x": 255,
        "y": 844,
        "w": 240,
        "h": 72,
        "text": "Clean Again",
        "style": {
          "fontSize": 24,
          "color": "#ffffff",
          "backgroundColor": "#0ea5e9",
          "borderRadius": 8,
          "align": "center"
        },
        "event": "game.restart",
        "targetState": "gameplay"
      },
      {
        "id": "menu_btn",
        "type": "button",
        "x": 255,
        "y": 948,
        "w": 240,
        "h": 72,
        "text": "Back to Menu",
        "style": {
          "fontSize": 24,
          "color": "#ffffff",
          "backgroundColor": "#0ea5e9",
          "borderRadius": 8,
          "align": "center"
        },
        "event": "menu.return",
        "targetState": "menu"
      }
    ]
  }
}