{
  "schemaVersion": "ovoui-skin@1",
  "name": "paused_skin",
  "canvas": {
    "width": 750,
    "height": 1334
  },
  "root": {
    "id": "root",
    "type": "container",
    "x": 0,
    "y": 0,
    "w": 750,
    "h": 1334,
    "children": [
      {
        "id": "pause_overlay",
        "type": "container",
        "x": 225,
        "y": 200,
        "w": 300,
        "h": 300,
        "text": "Paused",
        "style": {
          "fontSize": 28,
          "fill": "#ffffff",
          "align": "center"
        }
      },
      {
        "id": "resume_btn",
        "type": "button",
        "x": 255,
        "y": 532,
        "w": 240,
        "h": 72,
        "text": "Resume",
        "style": {
          "fontSize": 24,
          "color": "#ffffff",
          "backgroundColor": "#0ea5e9",
          "borderRadius": 8,
          "align": "center"
        },
        "event": "game.resume",
        "targetState": "gameplay"
      },
      {
        "id": "quit_btn",
        "type": "button",
        "x": 255,
        "y": 636,
        "w": 240,
        "h": 72,
        "text": "Quit",
        "style": {
          "fontSize": 24,
          "color": "#ffffff",
          "backgroundColor": "#0ea5e9",
          "borderRadius": 8,
          "align": "center"
        },
        "event": "game.menu",
        "targetState": "menu"
      }
    ]
  }
}