{
  "schemaVersion": "ovoui-skin@1",
  "name": "gameplay_skin",
  "canvas": {
    "width": 750,
    "height": 1334
  },
  "root": {
    "id": "root",
    "type": "container",
    "x": 0,
    "y": 0,
    "w": 750,
    "h": 1334,
    "children": [
      {
        "id": "game-canvas",
        "type": "container",
        "x": 50,
        "y": 220,
        "w": 650,
        "h": 520
      },
      {
        "id": "pause-btn",
        "type": "button",
        "x": 620,
        "y": 40,
        "w": 80,
        "h": 56,
        "text": "⏸",
        "style": {
          "fontSize": 24,
          "color": "#ffffff",
          "backgroundColor": "#0ea5e9",
          "borderRadius": 8,
          "align": "center"
        },
        "event": "game.pause"
      },
      {
        "id": "htp-btn",
        "type": "button",
        "x": 520,
        "y": 40,
        "w": 80,
        "h": 56,
        "text": "❓",
        "style": {
          "fontSize": 24,
          "color": "#ffffff",
          "backgroundColor": "#0ea5e9",
          "borderRadius": 8,
          "align": "center"
        },
        "event": "help.show"
      },
      {
        "id": "message-bar",
        "type": "text",
        "x": 175,
        "y": 110,
        "w": 400,
        "h": 40,
        "text": "Drag to aim, release to shoot",
        "style": {
          "fontSize": 22,
          "fill": "#ffffff",
          "align": "center"
        }
      },
      {
        "id": "power-meter",
        "type": "progress",
        "x": 225,
        "y": 780,
        "w": 300,
        "h": 16,
        "value": 0,
        "maxWidth": 300,
        "style": {
          "fill": "#0ea5e9",
          "borderRadius": 8
        }
      }
    ]
  }
}