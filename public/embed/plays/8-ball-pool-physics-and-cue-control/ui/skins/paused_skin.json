{
  "schemaVersion": "ovoui-skin@1",
  "name": "paused_skin",
  "canvas": {
    "width": 750,
    "height": 1334
  },
  "root": {
    "id": "root",
    "type": "container",
    "x": 0,
    "y": 0,
    "w": 750,
    "h": 1334,
    "children": [
      {
        "id": "pause-overlay",
        "type": "container",
        "x": 225,
        "y": 200,
        "w": 300,
        "h": 300
      },
      {
        "id": "pause-title",
        "type": "text",
        "x": 175,
        "y": 532,
        "w": 400,
        "h": 48,
        "text": "⏸ PAUSED",
        "style": {
          "fontSize": 28,
          "fill": "#ffffff",
          "align": "center"
        }
      },
      {
