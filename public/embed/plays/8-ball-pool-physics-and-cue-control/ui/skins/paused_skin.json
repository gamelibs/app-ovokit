        "x": 255,
        "y": 716,
        "w": 240,
        "h": 72,
        "text": "🔄 NEW GAME",
        "style": {
          "fontSize": 24,
          "color": "#ffffff",
          "backgroundColor": "#0ea5e9",
          "borderRadius": 8,
          "align": "center"
        },
        "event": "game.restart"
      },
      {
        "id": "volume-slider",
        "type": "container",
