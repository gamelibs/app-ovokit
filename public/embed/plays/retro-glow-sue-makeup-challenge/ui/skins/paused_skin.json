          "fontSize": 24,
          "color": "#ffffff",
          "backgroundColor": "#0ea5e9",
          "borderRadius": 8,
          "align": "center"
        },
        "event": "game.resume"
      },
      {
        "id": "restart_btn",
        "type": "button",
        "x": 255,
        "y": 384,
        "w": 240,
        "h": 72,
        "text": "Restart",
        "style": {
          "fontSize": 24,
          "color": "#ffffff",
          "backgroundColor": "#0ea5e9",
          "borderRadius": 8,
          "align": "center"
        },
        "event": "game.restart"
      },
      {
        "id": "menu_btn_pause",
        "type": "button",
        "x": 255,
        "y": 488,
        "w": 240,
        "h": 72,
        "text": "Main Menu",
        "style": {
          "fontSize": 24,
          "color": "#ffffff",
          "backgroundColor": "#0ea5e9",
          "borderRadius": 8,
          "align": "center"
        },
        "event": "game.menu"
      }
