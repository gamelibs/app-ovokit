{
  "schemaVersion": "ovoui-skin@1",
  "name": "paused_skin",
  "canvas": {
    "width": 750,
    "height": 1334
  },
  "root": {
    "id": "root",
    "type": "container",
    "x": 0,
    "y": 0,
    "w": 750,
    "h": 1334,
    "children": [
      {
        "id": "pause_title",
        "type": "text",
        "x": 175,
        "y": 200,
        "w": 400,
        "h": 48,
        "text": "⏸️ Paused",
        "style": {
          "fontSize": 28,
          "fill": "#ffffff",
          "align": "center"
        }
      },
      {
        "id": "resume_btn",
        "type": "button",
        "x": 255,
        "y": 280,
        "w": 240,
        "h": 72,
        "text": "Resume",
