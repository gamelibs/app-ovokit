{
  "schemaVersion": "ovoui-skin@1",
  "name": "result_skin",
  "canvas": {
    "width": 750,
    "height": 1334
  },
  "root": {
    "id": "root",
    "type": "container",
    "x": 0,
    "y": 0,
    "w": 750,
    "h": 1334,
    "children": [
      {
        "id": "result_title",
        "type": "text",
        "x": 175,
        "y": 200,
        "w": 400,
        "h": 48,
        "text": "Game Over",
        "style": {
          "fontSize": 28,
          "fill": "#ffffff",
          "align": "center"
        }
      },
      {
        "id": "result_score",
        "type": "text",
        "x": 175,
        "y": 280,
        "w": 400,
        "h": 48,
        "text": "Score: 0",
        "style": {
          "fontSize": 28,
          "fill": "#ffffff",
          "align": "center"
        }
      },
      {
        "id": "result_lives",
        "type": "text",
        "x": 175,
        "y": 360,
        "w": 400,
        "h": 48,
        "text": "Lives: 0",
        "style": {
          "fontSize": 28,
          "fill": "#ffffff",
          "align": "center"
        }
      },
      {
        "id": "result_restart_btn",
        "type": "button",
        "x": 255,
        "y": 440,
        "w": 240,
        "h": 72,
        "text": "Play Again",
        "style": {
          "fontSize": 24,
          "color": "#ffffff",
          "backgroundColor": "#0ea5e9",
          "borderRadius": 8,
          "align": "center"
        },
        "event": "game.restart",
        "targetState": "gameplay"
      },
      {
        "id": "result_menu_btn",
        "type": "button",
        "x": 255,
        "y": 544,
        "w": 240,
        "h": 72,
        "text": "Back to Menu",
        "style": {
          "fontSize": 24,
          "color": "#ffffff",
          "backgroundColor": "#0ea5e9",
          "borderRadius": 8,
          "align": "center"
        },
        "event": "game.menu",
        "targetState": "menu"
      }
    ]
  }
}