{
  "schemaVersion": "ovoui-skin@1",
  "name": "gameplay_skin",
  "canvas": {
    "width": 750,
    "height": 1334
  },
  "root": {
    "id": "root",
    "type": "container",
    "x": 0,
    "y": 0,
    "w": 750,
    "h": 1334,
    "children": [
      {
        "id": "game_background",
        "type": "image",
        "x": 275,
        "y": 200,
        "w": 200,
        "h": 200,
        "text": "Game Background",
        "style": {
          "fill": "#334155"
        }
      },
      {
        "id": "bubble_grid",
        "type": "container",
        "x": 225,
        "y": 432,
        "w": 300,
        "h": 300,
        "text": "Bubble Grid Area",
        "style": {
          "fontSize": 28,
          "fill": "#ffffff",
          "align": "center"
        }
      },
      {
        "id": "launcher",
        "type": "image",
        "x": 275,
        "y": 764,
        "w": 200,
        "h": 200,
        "text": "Bubble Launcher",
        "style": {
          "fill": "#334155"
        }
      },
      {
        "id": "current_bubble",
        "type": "image",
        "x": 275,
        "y": 996,
        "w": 200,
        "h": 200,
        "text": "Current: {{currentBubble}}",
        "style": {
          "fill": "#334155"
        }
      },
      {
        "id": "next_bubble",
        "type": "image",
        "x": 275,
        "y": 1228,
        "w": 200,
        "h": 200,
        "text": "Next Bubble",
        "style": {
          "fill": "#334155"
        }
      },
      {
        "id": "score_display",
        "type": "text",
        "x": 175,
        "y": 40,
        "w": 400,
        "h": 48,
        "text": "Score: {{score}}"
      },
      {
        "id": "pause_btn",
        "type": "button",
        "x": 255,
        "y": 1540,
        "w": 240,
        "h": 72,
        "text": "Pause",
        "style": {
          "fontSize": 24,
          "color": "#ffffff",
          "backgroundColor": "#0ea5e9",
          "borderRadius": 8,
          "align": "center"
        },
        "event": "game.pause",
        "targetState": "paused"
      },
      {
        "id": "game-canvas",
        "type": "container",
        "x": 75,
        "y": 220,
        "w": 600,
        "h": 640
      },
      {
        "id": "shoot_center",
        "type": "button",
        "x": 265,
        "y": 980,
        "w": 220,
        "h": 72,
        "text": "Shoot",
        "event": "bubble.shoot",
        "eventParams": {
          "angle": 0
        }
      },
      {
        "id": "shoot_left",
        "type": "button",
        "w": 220,
        "h": 72,
        "style": {
          "fontSize": 22,
          "color": "#ffffff",
          "backgroundColor": "#0ea5e9",
          "borderRadius": 8,
          "align": "center"
        },
        "text": "Shoot Left",
        "event": "bubble.shoot",
        "eventParams": {
          "angle": -45
        },
        "x": 50,
        "y": 980
      },
      {
        "id": "shoot_right",
        "type": "button",
        "w": 220,
        "h": 72,
        "style": {
          "fontSize": 22,
          "color": "#ffffff",
          "backgroundColor": "#0ea5e9",
          "borderRadius": 8,
          "align": "center"
        },
        "text": "Shoot Right",
        "event": "bubble.shoot",
        "eventParams": {
          "angle": 45
        },
        "x": 590,
        "y": 980
      }
    ]
  }
}