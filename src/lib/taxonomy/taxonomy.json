{
  "protocol": "ovo-taxonomy",
  "version": "1.0.0",
  "updated": "2026-07-19",
  "description": "OVO 游戏玩法分类协议。唯一真相源。核心原则：分类基于【设计/行为/逻辑层】，不关心表象题材与运营标签；游戏 = 行为原语的组合，公共模块 = 行为原语的实现。规则见同目录 README.md。运营层题材标签暂缓（见 deferred-themes.v0.json，不参与分类）。",
  "layers": {
    "behaviorPrimitive": {
      "label": "行为原语层（模块抽离依据）",
      "definition": "不可再分的物理逻辑行为规则（碰撞/比较/消除/回合…）。每个原语对应一组判定规则、数值参数和公共模块。",
      "cardinality": "composition"
    },
    "archetype": {
      "label": "行为母型层（游戏分类依据）",
      "definition": "玩家核心行为的命名组合（行为层概念，非市场主题）。每个游戏有且仅有一个主母型，可有一个次母型。",
      "cardinality": "one-primary"
    },
    "pattern": {
      "label": "原型层（系统循环结构）",
      "definition": "主循环的系统结构（输入→什么→反馈）。恰好 1 个，默认由主母型 defaultPattern 推导。",
      "cardinality": "exactly-one"
    },
    "feature": {
      "label": "特征层（玩家可感知修饰）",
      "definition": "修饰性机制标签，多选。工程概念（状态机/程序化生成）不在此层。",
      "cardinality": "zero-to-many"
    },
    "outOfScope": {
      "label": "超纲类型（显式排除）",
      "definition": "创造/装扮/绘画/沙盒等无输赢判定的表达型玩法：本协议不为其定义母型，样本标记 outOfScope=true，不做拆解 demo。"
    }
  },
