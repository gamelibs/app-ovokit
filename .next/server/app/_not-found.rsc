15:[["$","title","0",{"children":"GamesLog - 游戏玩法分享与学习"}],["$","meta","1",{"name":"description","content":"GamesLog 是面向游戏爱好者的玩法技术分享站：拆解经典游戏的核心机制与规则循环，用手绘流程图讲清设计原理，并提供可直接试玩的最小 Demo，帮你从玩家视角进阶到设计师视角，理解游戏为什么好玩。"}],["$","meta","2",{"name":"keywords","content":"游戏玩法,玩法拆解,游戏机制,规则循环,游戏设计,玩法 Demo,GamesLog"}],["$","meta","3",{"property":"og:title","content":"GamesLog - 游戏玩法分享与学习"}],["$","meta","4",{"property":"og:description","content":"GamesLog 是面向游戏爱好者的玩法技术分享站：拆解经典游戏的核心机制与规则循环，用手绘流程图讲清设计原理，并提供可直接试玩的最小 Demo，帮你从玩家视角进阶到设计师视角，理解游戏为什么好玩。"}],["$","meta","5",{"property":"og:site_name","content":"GamesLog"}],["$","meta","6",{"property":"og:locale","content":"zh_CN"}],["$","meta","7",{"property":"og:type","content":"website"}],["$","meta","8",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","9",{"name":"twitter:title","content":"GamesLog - 游戏玩法分享与学习"}],["$","meta","10",{"name":"twitter:description","content":"GamesLog 是面向游戏爱好者的玩法技术分享站：拆解经典游戏的核心机制与规则循环，用手绘流程图讲清设计原理，并提供可直接试玩的最小 Demo，帮你从玩家视角进阶到设计师视角，理解游戏为什么好玩。"}],["$","link","11",{"rel":"icon","href":"/favicon.ico?ddc049a9b16b1e5c","type":"image/x-icon","sizes":"16x16"}],["$","link","12",{"rel":"icon","href":"/icon.svg?bdfc1ab0e01820fc","type":"image/svg+xml","sizes":"any"}],["$","link","13",{"rel":"apple-touch-icon","href":"/apple-icon.png?4fddf0b199abce4d","type":"image/png","sizes":"180x180"}],["$","$L16","14",{}]]
