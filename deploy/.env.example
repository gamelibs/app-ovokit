# GamesLog 运行期环境变量（产物模式：服务器只需要本文件中的变量）
# 用法：cp .env.example .env.local，填写真实值后 chmod 600 .env.local

# 站点公开 URL（必填；生产必须是 https 真实域名，影响 canonical/sitemap/OG/HSTS）
NEXT_PUBLIC_SITE_URL=https://gameslog.top
# 联系邮箱（联系页展示与表单接收）
NEXT_PUBLIC_CONTACT_EMAIL=h5gamelog@gmail.com

# Google Analytics 4 Measurement ID（可选，填写 G-XXXXXXXXXX 后启用）
NEXT_PUBLIC_GA_ID=
# Cloudflare Web Analytics token（可选，无 Cookie）
NEXT_PUBLIC_CF_ANALYTICS_TOKEN=

# 版主口令（必填，必须 >=16 位强口令）
MOD_PASSWORD=your_mod_password

# 联系表单通知（可选；Webhook 与 Gmail 二选一或都配）
# CONTACT_WEBHOOK_URL=https://hooks.slack.com/services/...
# CONTACT_WEBHOOK_SECRET=your_webhook_secret_or_token
# GOOGLE_CLIENT_ID=your_client_id
# GOOGLE_CLIENT_SECRET=your_client_secret
# GOOGLE_REFRESH_TOKEN=your_refresh_token
# GOOGLE_SENDER_EMAIL=h5gamelog@gmail.com
# GOOGLE_REDIRECT_URI=https://gameslog.top

# Upstash Redis（view/like 统计持久化，生产必填；不配置则回退文件系统，重启/多实例丢数据）
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token

# AI 服务（版主后台 AI 分析/封面生成，可选）
# MOONSHOT_API_KEY=your_moonshot_api_key

# Web 端口（可选，默认 13100；需与 ecosystem.config.js 的 PORT 一致）
# PORT=13100
